@page
@model FileGenerationUIApp.Pages.Masters.RolesModel
@{
    ViewData["Title"] = "Roles";
}

<div class="container mt-4">
    <h2>Roles</h2>
    <p>Listing roles from backend API.</p>
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info">@Model.StatusMessage</div>
    }

    <div class="card mb-3 p-3">
        <form method="post">
            <div class="row">
                <div class="col-md-4">
                    <input asp-for="NewRoleName" class="form-control" placeholder="Role name" />
                </div>
                <div class="col-md-4">
                    <input asp-for="NewRoleDescription" class="form-control" placeholder="Description (optional)" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary" type="submit">Create Role</button>
                </div>
            </div>
        </form>
    </div>
    @if (Model.Roles == null || !Model.Roles.Any())
    {
        <div class="alert alert-info">No roles found.</div>
    }
    else
    {
        <table class="table table-striped">
            <thead><tr><th>#</th><th>Name</th><th>Description</th></tr></thead>
            <tbody>
                @for (int i = 0; i < Model.Roles.Count; i++)
                {
                    <tr>
                        <td>@(i+1)</td>
                        <td>@Model.Roles[i].GetValueOrDefault("name")</td>
                        <td>@Model.Roles[i].GetValueOrDefault("description")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
