<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FileGenerationUIApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FileGenerationUIApp.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        // parse token once and decide whether to render full navigation
        string? token = Context.Request.Cookies["ApiToken"];
        string? username = null;
        string? role = null;
        if (!string.IsNullOrEmpty(token))
        {
            try
            {
                var parts = token.Split('.');
                if (parts.Length > 1)
                {
                    var payload = parts[1];
                    payload = payload.Replace('-', '+').Replace('_', '/');
                    switch (payload.Length % 4)
                    {
                        case 2: payload += "=="; break;
                        case 3: payload += "="; break;
                    }
                    var bytes = System.Convert.FromBase64String(payload);
                    var json = System.Text.Encoding.UTF8.GetString(bytes);
                    using var doc = System.Text.Json.JsonDocument.Parse(json);
                    var root = doc.RootElement;
                    if (root.TryGetProperty("unique_name", out var n)) username = n.GetString();
                    else if (root.TryGetProperty("name", out n)) username = n.GetString();
                    else if (root.TryGetProperty("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name", out n)) username = n.GetString();

                    if (root.TryGetProperty("role", out var r))
                    {
                        if (r.ValueKind == System.Text.Json.JsonValueKind.String) role = r.GetString();
                        else if (r.ValueKind == System.Text.Json.JsonValueKind.Array) role = string.Join(",", r.EnumerateArray().Select(x => x.GetString()));
                    }
                    else if (root.TryGetProperty("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/role", out r)) role = r.GetString();
                }
            }
            catch { }
        }

        if (!string.IsNullOrEmpty(username))
        {
            <header>
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                    <div class="container">
                        <a class="navbar-brand" asp-area="" asp-page="/Index">FileGenerationUIApp</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/Dashboard/Index">Dashboard</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="mastersDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Masters</a>
                                    <ul class="dropdown-menu" aria-labelledby="mastersDropdown">
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Masters/Roles">Roles</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Masters/Departments">Departments</a></li>
                                        <li><a class="dropdown-item" asp-area="" asp-page="/Masters/Designation">Designation</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                                </li>
                            </ul>
                            <div class="d-flex align-items-center">
                                <div class="dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="me-1">@username</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                                        <li class="dropdown-item-text">Signed in as <strong>@username</strong></li>
                                        @if(!string.IsNullOrEmpty(role)) { <li class="dropdown-item-text">Role: @role</li> }
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-page="/Dashboard/Index">Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-page="/Logout">Logout</a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </nav>
            </header>
        }
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - FileGenerationUIApp - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>